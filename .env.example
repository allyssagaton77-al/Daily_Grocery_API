# -----------------------------------------------------------------------------
# Daily Grocery — BACKEND environment variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env or put these values in frontend/.
# -----------------------------------------------------------------------------

# Server
PORT=4000
FRONTEND_URL=http://localhost:5173,http://localhost:5174,http://localhost:4173

# Supabase (service role key is BACKEND ONLY)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY

# Payments: demo | maya | paymongo
# demo = local sandbox page (no real keys needed)
PAYMENT_PROVIDER=demo

# Maya Checkout API base URL
# Sandbox: https://pg-sandbox.paymaya.com
# Production: https://pg.maya.ph
MAYA_BASE_URL=https://pg-sandbox.paymaya.com

# Maya return URLs (must match routes in the frontend)
MAYA_SUCCESS_URL=http://localhost:5173/payment-success
MAYA_FAILURE_URL=http://localhost:5173/payment-failed
MAYA_CANCEL_URL=http://localhost:5173/cart

MAYA_API_KEY=YOUR_MAYA_PUBLIC_KEY
MAYA_API_SECRET=YOUR_MAYA_SECRET_KEY

# PayMongo (sandbox secret key starts with sk_test_)
PAYMONGO_SECRET_KEY=

# AI: none | gemini | openai
# none = grounded answers from your own Supabase catalog only
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
